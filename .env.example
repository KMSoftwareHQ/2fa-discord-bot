# Copy to .env and fill in values. Never commit .env.

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token.
DISCORD_BOT_TOKEN=
# Application ID from the same page -> General Information -> Application ID.
DISCORD_APPLICATION_ID=
# Register slash commands to ONE guild instead of globally. Strongly preferred:
# guild commands appear instantly and stay out of every other server the bot is
# ever invited to. Leave empty to register globally (propagation takes ~1h).
DISCORD_GUILD_ID=

# --- Vault -----------------------------------------------------------------
# 64 hex characters = the 32-byte AES-256-GCM key. Generate one with:
#   npm run vault -- genkey
# Losing this key permanently destroys every stored seed; there is no recovery
# path. Back it up SEPARATELY from data/vault.db — a backup holding both is
# worth exactly as much as an unencrypted one.
VAULT_MASTER_KEY=

# Only read by `npm run vault -- rotate-key`. Set it to the NEW key, run the
# rotation, then move that value into VAULT_MASTER_KEY and clear this.
VAULT_NEW_MASTER_KEY=

# --- Paths -----------------------------------------------------------------
# Defaults are fine for both the source and Docker layouts.
# DATABASE_PATH=data/vault.db
# ACL_PATH=config/acl.json

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug. No level ever logs a seed or an issued code.
# LOG_LEVEL=info

# --- Docker only ------------------------------------------------------------
# The uid/gid the container runs as. It must be able to read config/acl.json
# and write the data volume. Set these to your own `id -u` and `id -g`; the
# default matches the image's built-in `node` user.
# APP_UID=1000
# APP_GID=1000
