{
  "name": "2fa-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot that hands out live TOTP codes to an explicit per-secret allowlist of Discord user IDs. Seeds are encrypted at rest with AES-256-GCM and never leave the server.",
  "license": "MIT",
  "keywords": [
    "discord",
    "discord-bot",
    "totp",
    "2fa",
    "mfa",
    "otp",
    "rfc6238",
    "shared-credentials",
    "self-hosted",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KMSoftwareHQ/2fa-discord-bot.git"
  },
  "homepage": "https://github.com/KMSoftwareHQ/2fa-discord-bot#readme",
  "bugs": {
    "url": "https://github.com/KMSoftwareHQ/2fa-discord-bot/issues"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "vault": "node dist/cli.js",
    "deploy-commands": "node dist/discord/deploy-commands.js",
    "test": "tsc && node --test dist",
    "check:clean": "bash scripts/check-clean.sh"
  },
  "dependencies": {
    "@otplib/core": "^12.0.1",
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "otplib": "^12.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.50",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
